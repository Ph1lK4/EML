<Window x:Class="EML.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EML"
        Width="1000"
        Height="640"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <!-- 每个标签页从 MainViewModel 取得自己的数据来源，保留原 Java 页面绑定。 -->
    <TabControl Margin="12">
      <TabItem Header="本地实例" DataContext="{Binding Instances}">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBox Text="{Binding InstancesRoot, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap"/>
          <!-- 写入操作期间禁用选择和其他命令；取消导出始终由异步命令管理。 -->
          <WrapPanel Grid.Row="1" Margin="0,12">
            <Button Content="刷新实例" Command="{Binding RefreshCommand}" Padding="12,6" Margin="0,0,8,4"/>
            <Button Content="导入实例" Command="{Binding ImportCommand}" Padding="12,6" Margin="0,0,8,4" ToolTip="支持 Prism ZIP、Modrinth mrpack、CurseForge ZIP 和通用游戏目录 ZIP"/>
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="180" MaxLength="128" IsEnabled="{Binding CanInteract}" ToolTip="新的实例名称，同时修改文件夹名称" Margin="0,0,8,4" VerticalContentAlignment="Center"/>
            <Button Content="重命名" Command="{Binding RenameCommand}" Padding="12,6" Margin="0,0,8,4"/>
            <Button Content="删除实例" Command="{Binding DeleteCommand}" Padding="12,6" Margin="0,0,8,4"/>
            <Button Content="导出 ZIP" Command="{Binding ExportCommand}" Padding="12,6" Margin="0,0,8,4" ToolTip="完整备份实例目录；请先关闭游戏。不包含实例外的共享依赖。"/>
            <Button Content="取消导出" Command="{Binding ExportCancelCommand}" Padding="12,6" Margin="0,0,0,4"/>
            <Button Content="取消导入 / 自动补全" Command="{Binding ImportCancelCommand}" Padding="12,6" Margin="8,0,0,4"/>
          </WrapPanel>
          <DataGrid Grid.Row="2" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" IsEnabled="{Binding CanInteract}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="实例名称" Binding="{Binding Name}" Width="2*"/>
              <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="90"/>
              <DataGridTextColumn Header="Minecraft 版本" Binding="{Binding MinecraftVersionDisplay}" Width="130"/>
              <DataGridTextColumn Header="加载器 / 组件" Binding="{Binding LoaderDisplay}" Width="2*"/>
            </DataGrid.Columns>
          </DataGrid>
          <!-- 下方详情绑定 SelectedInstance，选择不同实例时自动显示对应路径和提示。 -->
          <TabControl Grid.Row="3" Margin="0,12,0,0" SelectedIndex="{Binding SelectedDetailTab}">
          <TabItem Header="实例详情">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
            <StackPanel>
              <TextBlock Text="实例路径" FontWeight="SemiBold"/>
              <TextBox Text="{Binding SelectedInstance.InstancePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
              <TextBlock Text="游戏目录" FontWeight="SemiBold" Margin="0,8,0,0"/>
              <TextBox Text="{Binding SelectedInstance.GameDirectory, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding SelectedInstance.Versions}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate><StackPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding VersionId, StringFormat=版本配置 ID：{0}}"/>
                    <TextBlock Text="{Binding MetadataPath}" TextWrapping="Wrap" Foreground="DimGray"/>
                  </StackPanel></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="扫描 / 导入说明（本次检查结果见“文件检查”）" Margin="0,6,0,0"/>
              <TextBlock Text="{Binding SelectedInstance.WarningDisplay}" Foreground="#9B4D00" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
          </TabItem>
          <TabItem Header="文件检查">
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <WrapPanel>
                <Button Content="快速检查" Command="{Binding QuickCheckCommand}" Padding="10,4" Margin="0,0,6,6" ToolTip="检查文件存在性和大小，不计算哈希"/>
                <Button Content="完整检查" Command="{Binding FullCheckCommand}" Padding="10,4" Margin="0,0,6,6" ToolTip="读取清单文件并校验所有声明的哈希"/>
                <Button Content="取消快速检查" Command="{Binding QuickCheckCancelCommand}" Padding="10,4" Margin="0,0,6,6"/>
                <Button Content="取消完整检查" Command="{Binding FullCheckCancelCommand}" Padding="10,4" Margin="0,0,6,6"/>
              </WrapPanel>
              <ScrollViewer Grid.Row="1" MaxHeight="92" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="{Binding CheckSummary}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding CheckNotes}" TextWrapping="Wrap" Foreground="#9B4D00" Margin="0,4,0,6"/>
                </StackPanel>
              </ScrollViewer>
              <DataGrid Grid.Row="2" ItemsSource="{Binding CheckFiles}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="文件 / 引用" Binding="{Binding PathDisplay}" Width="2*"/>
                  <DataGridTextColumn Header="要求" Binding="{Binding RequiredDisplay}" Width="55"/>
                  <DataGridTextColumn Header="状态" Binding="{Binding StateDisplay}" Width="115"/>
                  <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="3*"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
          <TabItem Header="补全实例依赖">
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <WrapPanel>
                <Button Content="补全实例依赖" Command="{Binding DownloadMissingCommand}" Padding="10,4" Margin="0,0,6,6" ToolTip="按整合包声明下载必需模组及支持的运行依赖；CurseForge 使用内置授权直接下载，受限制文件会提供手动处理提示"/>
                <Button Content="取消下载 / 复查" Command="{Binding CancelDependencyDownloadCommand}" Padding="10,4" Margin="0,0,6,6"/>
              </WrapPanel>
              <!-- 下载错误和完整配置路径可能较长，限制摘要高度并保留滚动阅读。 -->
              <ScrollViewer Grid.Row="1" MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                <TextBlock Text="{Binding DownloadSummary}" TextWrapping="Wrap"/>
              </ScrollViewer>
              <DataGrid Grid.Row="2" ItemsSource="{Binding DownloadFiles}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="文件 / 引用" Binding="{Binding PathDisplay}" Width="2*"/>
                  <DataGridTextColumn Header="结果" Binding="{Binding StateDisplay}" Width="115"/>
                  <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="3*"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
          </TabControl>
          <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <ProgressBar Value="{Binding TransferPercent}" Minimum="0" Maximum="100" Height="6"/>
            <TextBlock Text="{Binding TransferStatus}" TextTrimming="CharacterEllipsis"/>
            <ScrollViewer MaxHeight="42" VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
            </ScrollViewer>
          </StackPanel>
        </Grid>
      </TabItem>
      <!-- Java 页继续复用原检测命令；启动自动检测不会替代手动刷新。 -->
      <TabItem Header="Java 环境" DataContext="{Binding Java}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="24"
            FontWeight="SemiBold"
            Text="Java 环境"/>

        <Button
            Grid.Row="1"
            Width="120"
            Height="34"
            Margin="0,16,0,16"
            HorizontalAlignment="Left"
            Command="{Binding DetectJavaCommand}"
            Content="检测 Java"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="检测结果">
                <ListBox
                    ItemsSource="{Binding Installations}"
                    SelectedItem="{Binding SelectedInstallation}"
                    DisplayMemberPath="ExecutablePath"/>
            </GroupBox>

            <GroupBox
                Grid.Column="2"
                Header="Java 信息">

                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="路径："/>
                    <TextBlock
                        Grid.Column="1"
                        TextWrapping="Wrap"
                        Text="{Binding SelectedInstallation.ExecutablePath}"/>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        Text="版本："/>
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,12,0,0"
                        Text="{Binding SelectedInstallation.Version}"/>

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        Text="架构："/>
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,12,0,0"
                        Text="{Binding SelectedInstallation.Architecture}"/>
                </Grid>
            </GroupBox>
        </Grid>

        <Border
            Grid.Row="3"
            Margin="0,16,0,0"
            Padding="12"
            Background="#F0F0F0"
            CornerRadius="4">

            <TextBlock Text="{Binding StatusText}"/>
        </Border>
    </Grid>
      </TabItem>
    </TabControl>
</Window>
