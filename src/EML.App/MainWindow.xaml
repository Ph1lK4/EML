<!--
  ════════════════════════════════════════════════════════════════════
   文件：MainWindow.xaml
   位置：src\EML.App
   作用：主窗口布局。只负责「摆控件 + 绑定」，不写逻辑。

   分区：
     1. Java 环境检测（原有功能）
     2. 启动 1.7.10（这一步新增：生成启动命令）
     3. 底部状态栏（显示 Java 检测状态）

   绑定约定：
     窗口的 DataContext 只有一个 MainViewModel，
     所以所有绑定都以 Java.* 或 Launch.* 开头，对应两个子 ViewModel。
  ════════════════════════════════════════════════════════════════════
-->
<Window x:Class="EML.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EML"
        Width="760"
        Height="700"
        MinWidth="600"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 标题 -->
            <RowDefinition Height="Auto"/>  <!-- 检测按钮 -->
            <RowDefinition Height="*"/>     <!-- 分区 1：Java 检测 -->
            <RowDefinition Height="Auto"/>  <!-- 分区 2：启动 1.7.10 -->
            <RowDefinition Height="Auto"/>  <!-- 分区 3：状态栏 -->
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="24"
            FontWeight="SemiBold"
            Text="Java 环境"/>

        <!-- ════════════════════════════════════════════════════════════
             分区 1：Java 环境检测
             Java.DetectJavaCommand → JavaSettingsViewModel.DetectJavaAsync
             ════════════════════════════════════════════════════════════ -->
        <Button
            Grid.Row="1"
            Width="120"
            Height="34"
            Margin="0,16,0,16"
            HorizontalAlignment="Left"
            Command="{Binding Java.DetectJavaCommand}"
            Content="检测 Java"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：检测结果列表。x:Name 给「生成启动命令」按钮当 CommandParameter 用 -->
            <GroupBox Header="检测结果">
                <ListBox
                    x:Name="JavaList"
                    ItemsSource="{Binding Java.Installations}"
                    SelectedItem="{Binding Java.SelectedInstallation}"
                    DisplayMemberPath="ExecutablePath"/>
            </GroupBox>

            <!-- 右：选中项的详细信息 -->
            <GroupBox
                Grid.Column="2"
                Header="Java 信息">

                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="路径："/>
                    <TextBlock
                        Grid.Column="1"
                        TextWrapping="Wrap"
                        Text="{Binding Java.SelectedInstallation.ExecutablePath}"/>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        Text="版本："/>
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,12,0,0"
                        Text="{Binding Java.SelectedInstallation.Version}"/>

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        Text="架构："/>
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,12,0,0"
                        Text="{Binding Java.SelectedInstallation.Architecture}"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════
             分区 2：启动 1.7.10（第一步只生成命令，不启动游戏）
             Launch.GenerateCommand → LaunchViewModel.Generate
             CommandParameter 把左边列表选中的 Java 直接传进去
             ════════════════════════════════════════════════════════════ -->
        <GroupBox
            Grid.Row="3"
            Margin="0,16,0,0"
            Header="启动 1.7.10（第一步：只生成命令）">

            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="游戏目录："/>

                <TextBox
                    Grid.Column="1"
                    Text="{Binding Launch.GameDirectory, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Text="玩家名："/>

                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,8,0,0"
                    Text="{Binding Launch.PlayerName, UpdateSourceTrigger=PropertyChanged}"/>

                <Button
                    Grid.Row="2"
                    Grid.Column="1"
                    Width="140"
                    Height="34"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding Launch.GenerateCommand}"
                    CommandParameter="{Binding ElementName=JavaList, Path=SelectedItem}"
                    Content="生成启动命令"/>

                <!-- 生成出来的命令：只读，方便复制 -->
                <TextBox
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Height="90"
                    Margin="0,12,0,0"
                    IsReadOnly="True"
                    Text="{Binding Launch.CommandLine}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"/>

                <!-- 启动块自己的状态：成功 / 失败原因 -->
                <TextBlock
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0"
                    Foreground="#666"
                    Text="{Binding Launch.StatusText}"
                    TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>

        <!-- ════════════════════════════════════════════════════════════
             分区 3：底部状态栏（Java 检测块的状态）
             ════════════════════════════════════════════════════════════ -->
        <Border
            Grid.Row="4"
            Margin="0,16,0,0"
            Padding="12"
            Background="#F0F0F0"
            CornerRadius="4">

            <TextBlock Text="{Binding Java.StatusText}"/>
        </Border>
    </Grid>
</Window>
