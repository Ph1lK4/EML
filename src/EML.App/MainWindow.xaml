<Window x:Class="EML.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EML"
        Width="760"
        Height="480"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="24"
            FontWeight="SemiBold"
            Text="Java 环境"/>

        <Button
            Grid.Row="1"
            Width="120"
            Height="34"
            Margin="0,16,0,16"
            HorizontalAlignment="Left"
            Command="{Binding DetectJavaCommand}"
            Content="检测 Java"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="检测结果">
                <ListBox
                    ItemsSource="{Binding Installations}"
                    SelectedItem="{Binding SelectedInstallation}"
                    DisplayMemberPath="ExecutablePath"/>
            </GroupBox>

            <GroupBox
                Grid.Column="2"
                Header="Java 信息">

                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="路径："/>
                    <TextBlock
                        Grid.Column="1"
                        TextWrapping="Wrap"
                        Text="{Binding SelectedInstallation.ExecutablePath}"/>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        Text="版本："/>
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,12,0,0"
                        Text="{Binding SelectedInstallation.Version}"/>

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        Text="架构："/>
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,12,0,0"
                        Text="{Binding SelectedInstallation.Architecture}"/>
                </Grid>
            </GroupBox>
        </Grid>

        <Border
            Grid.Row="3"
            Margin="0,16,0,0"
            Padding="12"
            Background="#F0F0F0"
            CornerRadius="4">

            <TextBlock Text="{Binding StatusText}"/>
        </Border>
    </Grid>
</Window>