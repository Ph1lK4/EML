<Window x:Class="EML.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EML"
        Width="1000"
        Height="640"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <!-- 每个标签页从 MainViewModel 取得自己的数据来源，保留原 Java 页面绑定。 -->
    <TabControl Margin="12">
      <TabItem Header="本地实例" DataContext="{Binding Instances}">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBox Text="{Binding InstancesRoot, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap"/>
          <!-- 写入操作期间禁用选择和其他命令；取消导出始终由异步命令管理。 -->
          <WrapPanel Grid.Row="1" Margin="0,12">
            <Button Content="刷新实例" Command="{Binding RefreshCommand}" Padding="12,6" Margin="0,0,8,4"/>
            <Button Content="导入实例" Command="{Binding ImportCommand}" Padding="12,6" Margin="0,0,8,4" ToolTip="支持 Prism ZIP、Modrinth mrpack、CurseForge ZIP 和通用游戏目录 ZIP"/>
            <Button Content="启动游戏" Command="{Binding LaunchGameCommand}" Padding="12,6" Margin="0,0,8,4" FontWeight="SemiBold" ToolTip="快速准备后使用此实例的启动设置运行；不会每次执行整包检查"/>
            <Button Content="取消启动准备" Command="{Binding CancelLaunchPreparationCommand}" Padding="12,6" Margin="0,0,8,4"/>
            <Button Content="停止游戏" Command="{Binding StopGameCommand}" Padding="12,6" Margin="0,0,8,4" ToolTip="停止本次由 EML 启动的进程；建议优先在游戏内正常退出以保存进度"/>
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="180" MaxLength="128" IsEnabled="{Binding CanInteract}" ToolTip="新的实例名称，同时修改文件夹名称" Margin="0,0,8,4" VerticalContentAlignment="Center"/>
            <Button Content="重命名" Command="{Binding RenameCommand}" Padding="12,6" Margin="0,0,8,4"/>
            <Button Content="删除实例" Command="{Binding DeleteCommand}" Padding="12,6" Margin="0,0,8,4"/>
            <Button Content="导出 ZIP" Command="{Binding ExportCommand}" Padding="12,6" Margin="0,0,8,4" ToolTip="完整备份实例目录；请先关闭游戏。不包含实例外的共享依赖。"/>
            <Button Content="取消导出" Command="{Binding ExportCancelCommand}" Padding="12,6" Margin="0,0,0,4"/>
            <Button Content="取消导入 / 自动补全" Command="{Binding ImportCancelCommand}" Padding="12,6" Margin="8,0,0,4"/>
          </WrapPanel>
          <DataGrid Grid.Row="2" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" IsEnabled="{Binding CanInteract}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="实例名称" Binding="{Binding Name}" Width="2*"/>
              <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="90"/>
              <DataGridTextColumn Header="Minecraft 版本" Binding="{Binding MinecraftVersionDisplay}" Width="130"/>
              <DataGridTextColumn Header="加载器 / 组件" Binding="{Binding LoaderDisplay}" Width="2*"/>
            </DataGrid.Columns>
          </DataGrid>
          <!-- 下方详情绑定 SelectedInstance，选择不同实例时自动显示对应路径和提示。 -->
          <TabControl Grid.Row="3" Margin="0,12,0,0" SelectedIndex="{Binding SelectedDetailTab}">
          <TabItem Header="实例详情">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
            <StackPanel>
              <TextBlock Text="实例路径" FontWeight="SemiBold"/>
              <TextBox Text="{Binding SelectedInstance.InstancePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
              <TextBlock Text="游戏目录" FontWeight="SemiBold" Margin="0,8,0,0"/>
              <TextBox Text="{Binding SelectedInstance.GameDirectory, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding SelectedInstance.Versions}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate><StackPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding VersionId, StringFormat=版本配置 ID：{0}}"/>
                    <TextBlock Text="{Binding MetadataPath}" TextWrapping="Wrap" Foreground="DimGray"/>
                  </StackPanel></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="扫描 / 导入说明（本次检查结果见“文件检查”）" Margin="0,6,0,0"/>
              <TextBlock Text="{Binding SelectedInstance.WarningDisplay}" Foreground="#9B4D00" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
          </TabItem>
          <TabItem Header="文件检查">
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <WrapPanel>
                <Button Content="快速检查" Command="{Binding QuickCheckCommand}" Padding="10,4" Margin="0,0,6,6" ToolTip="检查文件存在性和大小，不计算哈希"/>
                <Button Content="完整检查" Command="{Binding FullCheckCommand}" Padding="10,4" Margin="0,0,6,6" ToolTip="读取清单文件并校验所有声明的哈希"/>
                <Button Content="取消快速检查" Command="{Binding QuickCheckCancelCommand}" Padding="10,4" Margin="0,0,6,6"/>
                <Button Content="取消完整检查" Command="{Binding FullCheckCancelCommand}" Padding="10,4" Margin="0,0,6,6"/>
              </WrapPanel>
              <ScrollViewer Grid.Row="1" MaxHeight="92" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="{Binding CheckSummary}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding CheckNotes}" TextWrapping="Wrap" Foreground="#9B4D00" Margin="0,4,0,6"/>
                </StackPanel>
              </ScrollViewer>
              <DataGrid Grid.Row="2" ItemsSource="{Binding CheckFiles}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="文件 / 引用" Binding="{Binding PathDisplay}" Width="2*"/>
                  <DataGridTextColumn Header="要求" Binding="{Binding RequiredDisplay}" Width="55"/>
                  <DataGridTextColumn Header="状态" Binding="{Binding StateDisplay}" Width="115"/>
                  <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="3*"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
          <TabItem Header="补全实例依赖">
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <WrapPanel>
                <Button Content="补全实例依赖" Command="{Binding DownloadMissingCommand}" Padding="10,4" Margin="0,0,6,6" ToolTip="按整合包声明下载必需模组及支持的运行依赖；CurseForge 使用内置授权直接下载，受限制文件会提供手动处理提示"/>
                <Button Content="取消下载 / 复查" Command="{Binding CancelDependencyDownloadCommand}" Padding="10,4" Margin="0,0,6,6"/>
              </WrapPanel>
              <!-- 下载错误和完整配置路径可能较长，限制摘要高度并保留滚动阅读。 -->
              <ScrollViewer Grid.Row="1" MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                <TextBlock Text="{Binding DownloadSummary}" TextWrapping="Wrap"/>
              </ScrollViewer>
              <DataGrid Grid.Row="2" ItemsSource="{Binding DownloadFiles}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="文件 / 引用" Binding="{Binding PathDisplay}" Width="2*"/>
                  <DataGridTextColumn Header="结果" Binding="{Binding StateDisplay}" Width="115"/>
                  <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="3*"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
          <!-- 新页面追加在末尾，保留详情、检查、补全的原有索引。 -->
          <TabItem Header="启动设置">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
              <StackPanel>
                <TextBlock Text="设置按实例保存。正版登录请先到“微软账号”页面完成授权，正版玩家名由账号决定。切换离线与正版身份会改变 UUID，单人存档可能因此显示不同的背包和进度。" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,8"/>
                <CheckBox Content="使用已登录的正版账号" IsChecked="{Binding UseMicrosoftAccount}" IsEnabled="{Binding CanEditLaunchSettings}" Margin="0,0,0,8"/>
                <Grid IsEnabled="{Binding CanEditLaunchSettings}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="离线玩家名称" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditOfflinePlayerName}" MaxLength="16" Margin="0,0,0,8" ToolTip="正版启动使用微软账号对应的 Minecraft 玩家名，此处仅保留离线设置"/>
                  <TextBlock Grid.Row="1" Text="Java 路径" VerticalAlignment="Center"/>
                  <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                    <ComboBox IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding Java.Installations}" DisplayMemberPath="ExecutablePath" Text="{Binding SelectedJavaPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="可选择已检测的 Java，或直接输入 java.exe 路径；清空后自动选择匹配版本"/>
                    <TextBlock Text="留空自动匹配实例所需 Java；可在“Java 环境”页面重新检测。" FontSize="11" Foreground="DimGray" TextWrapping="Wrap"/>
                  </StackPanel>
                  <TextBlock Grid.Row="2" Text="初始内存（MB）" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MinMemoryMbText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                  <TextBlock Grid.Row="3" Text="最大内存（MB）" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxMemoryMbText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                  <TextBlock Grid.Row="4" Text="附加 JVM 参数" VerticalAlignment="Top"/>
                  <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AdditionalJvmArguments, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" ToolTip="支持带引号的参数；内存由上方字段统一管理，不能覆盖主类、classpath 或实例关键参数"/>
                </Grid>
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="保存设置" Command="{Binding SaveLaunchSettingsCommand}" Padding="10,4" Margin="0,0,8,6"/>
                  <Button Content="重新读取" Command="{Binding ReloadLaunchSettingsCommand}" Padding="10,4" Margin="0,0,8,6" ToolTip="重新读取磁盘设置，放弃尚未保存的输入"/>
                  <Button Content="使用当前设置启动" Command="{Binding LaunchGameCommand}" Padding="10,4" Margin="0,0,8,6"/>
                </WrapPanel>
                <TextBlock Text="{Binding LaunchSettingsStatus}" TextWrapping="Wrap"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="运行日志">
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Text="{Binding RunningInstanceName, StringFormat=本次实例：{0}}" FontWeight="SemiBold"/>
              <StackPanel Grid.Row="1" Margin="0,4,0,4">
                <TextBlock Text="{Binding LaunchStatus}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LastExitCode, StringFormat=退出码：{0}, TargetNullValue=退出码：尚无}"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Margin="0,0,0,6">
                <TextBlock Text="完整日志位置（下方仅显示最近 1000 行）" Foreground="DimGray"/>
                <TextBox Text="{Binding LaunchLogPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
              </StackPanel>
              <ListBox Grid.Row="3" ItemsSource="{Binding LaunchLogLines}" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
            </Grid>
          </TabItem>
          <TabItem Header="GTNH 数据迁移">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
              <StackPanel>
                <TextBlock Text="先在上方选中新版 GTNH 实例，再从旧实例迁入数据。请先完成新版依赖补全并试运行。" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,10,0,8">
                  <Button Content="从旧 GTNH 迁入数据" Command="{Binding MigratePlayerDataCommand}" Padding="10,4" Margin="0,0,8,6"/>
                  <Button Content="取消迁移" Command="{Binding MigratePlayerDataCancelCommand}" Padding="10,4" Margin="0,0,8,6"/>
                  <Button Content="恢复上次迁移" Command="{Binding RestoreMigrationCommand}" Padding="10,4" Margin="0,0,8,6"/>
                  <Button Content="取消恢复预检" Command="{Binding RestoreMigrationCancelCommand}" Padding="10,4" Margin="0,0,8,6"/>
                </WrapPanel>
                <TextBlock Text="{Binding MigrationStatus}" TextWrapping="Wrap"/>
                <TextBlock Text="迁移记录及备份位置" Foreground="DimGray" Margin="0,8,0,4"/>
                <TextBox Text="{Binding MigrationJournalPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          </TabControl>
          <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <ProgressBar Value="{Binding TransferPercent}" Minimum="0" Maximum="100" Height="6"/>
            <TextBlock Text="{Binding TransferStatus}" TextTrimming="CharacterEllipsis"/>
            <ScrollViewer MaxHeight="42" VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
            </ScrollViewer>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="微软账号" DataContext="{Binding Accounts}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24">
          <StackPanel>
            <TextBlock Text="Minecraft Java 正版登录" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="使用拥有 Java 版许可的个人微软账号。密码只在微软网页输入，EML 不保存密码。" TextWrapping="Wrap" Margin="0,12,0,8"/>
            <TextBlock Text="{Binding ConfigurationStatus}" TextWrapping="Wrap" Foreground="DimGray"/>
            <TextBlock Text="{Binding AccountName, StringFormat=当前玩家：{0}}" FontSize="18" Margin="0,16,0,8"/>
            <TextBlock Text="{Binding AccountId, StringFormat=UUID：{0}}"/>
            <WrapPanel Margin="0,16,0,8">
              <Button Content="登录 / 更换微软账号" Command="{Binding LoginCommand}" Padding="12,6" Margin="0,0,8,8"/>
              <Button Content="取消登录" Command="{Binding LoginCancelCommand}" Padding="12,6" Margin="0,0,8,8"/>
              <Button Content="退出本机账号" Command="{Binding LogoutCommand}" Padding="12,6" Margin="0,0,8,8"/>
              <Button Content="重新读取账号" Command="{Binding LoadCommand}" Padding="12,6" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Text="微软验证网址"/>
            <TextBox Text="{Binding VerificationAddress, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,8"/>
            <TextBlock Text="验证码（仅在你主动发起的微软登录页面使用）"/>
            <TextBox Text="{Binding UserCode, Mode=OneWay}" IsReadOnly="True" FontSize="24" Margin="0,4,0,8"/>
            <Button Content="打开微软登录网页" Command="{Binding OpenLoginPageCommand}" HorizontalAlignment="Left" Padding="12,6"/>
            <!-- 登录失败时可直接复制安全诊断；其中不包含认证令牌或原始服务端响应。 -->
            <TextBox Text="{Binding StatusText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     BorderThickness="0" Background="Transparent" Margin="0,16,0,8"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- Java 页继续复用原检测命令；启动自动检测不会替代手动刷新。 -->
      <TabItem Header="Java 环境" DataContext="{Binding Java}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="24"
            FontWeight="SemiBold"
            Text="Java 环境"/>

        <Button
            Grid.Row="1"
            Width="120"
            Height="34"
            Margin="0,16,0,16"
            HorizontalAlignment="Left"
            Command="{Binding DetectJavaCommand}"
            Content="检测 Java"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="检测结果">
                <ListBox
                    ItemsSource="{Binding Installations}"
                    SelectedItem="{Binding SelectedInstallation}"
                    DisplayMemberPath="ExecutablePath"/>
            </GroupBox>

            <GroupBox
                Grid.Column="2"
                Header="Java 信息">

                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="路径："/>
                    <TextBlock
                        Grid.Column="1"
                        TextWrapping="Wrap"
                        Text="{Binding SelectedInstallation.ExecutablePath}"/>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        Text="版本："/>
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,12,0,0"
                        Text="{Binding SelectedInstallation.Version}"/>

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        Text="架构："/>
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,12,0,0"
                        Text="{Binding SelectedInstallation.Architecture}"/>
                </Grid>
            </GroupBox>
        </Grid>

        <Border
            Grid.Row="3"
            Margin="0,16,0,0"
            Padding="12"
            Background="#F0F0F0"
            CornerRadius="4">

            <TextBlock Text="{Binding StatusText}"/>
        </Border>
    </Grid>
      </TabItem>
    </TabControl>
</Window>
