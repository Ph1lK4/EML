<UserControl x:Class="EML.App.Views.JavaEnvironmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24">
      <Button DockPanel.Dock="Right" Content="重新检测 Java" Command="{Binding DetectJavaCommand}"
              Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Margin="16,4,0,0"/>
      <StackPanel>
        <TextBlock Text="Java 环境" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="查看本机可用的 Java。游戏启动时会按实例需求自动选择，也可以在启动设置中指定。"
                   Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardBorder}" Padding="18">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="4,0,4,16">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Installations.Count, StringFormat={}{0} 个环境}"
                       Foreground="{DynamicResource MutedTextBrush}"/>
            <TextBlock Text="检测结果" FontSize="17" FontWeight="SemiBold"/>
          </DockPanel>
          <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Installations}" SelectedItem="{Binding SelectedInstallation}"
                     BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="8,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                      <TextBlock Text="J" FontWeight="SemiBold" FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Version, StringFormat=Java {0}}" FontWeight="SemiBold" FontSize="15"/>
                      <TextBlock Text="{Binding Architecture}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,5"/>
                      <TextBlock Text="{Binding ExecutablePath}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                 TextWrapping="Wrap" ToolTip="{Binding ExecutablePath}"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="20">
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                <DataTrigger Binding="{Binding Installations.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
              </Style.Triggers></Style></StackPanel.Style>
              <TextBlock Text="暂未发现 Java" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="安装合适的 Java 后，点击重新检测。" Foreground="{DynamicResource MutedTextBrush}"
                         TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="环境信息" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,24"/>
            <TextBlock Text="版本" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding SelectedInstallation.Version, TargetNullValue=请选择左侧的 Java}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="架构" Foreground="{DynamicResource MutedTextBrush}" Margin="0,24,0,6"/>
            <TextBlock Text="{Binding SelectedInstallation.Architecture}" FontSize="16"/>
            <TextBlock Text="可执行文件" Foreground="{DynamicResource MutedTextBrush}" Margin="0,24,0,6"/>
            <TextBox Text="{Binding SelectedInstallation.ExecutablePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"/>
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,28,0,20"/>
            <TextBlock Text="这里选择的条目用于查看详情。要为单个实例指定 Java，请打开左侧“启动设置”页面并选择实例。"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="16,12" Margin="0,18,0,0">
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</UserControl>
