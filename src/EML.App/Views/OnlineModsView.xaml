<UserControl x:Class="EML.App.Views.OnlineModsView" Style="{StaticResource {x:Type UserControl}}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EML.App.Views"
             FontSize="14">
  <UserControl.Resources>
    <local:OnlineModLabelConverter x:Key="OnlineModLabel"/>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
    <Style x:Key="FilterLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
  </UserControl.Resources>
  <!-- 筛选区始终可见；结果与详情分别滚动，避免长介绍挤走搜索列表。 -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardBorder}" Padding="20,16,20,8">
      <StackPanel IsEnabled="{Binding CanEdit}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid Margin="0,0,12,0">
            <TextBox x:Name="SearchInput" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" Height="40" Padding="40,8,12,8"
                     ToolTip="支持已收录的中文模组名、别名和英文关键词；停止输入后自动搜索" AutomationProperties.Name="搜索模组"/>
            <!-- 图标与占位文字不接收鼠标事件，点击搜索区仍由原生输入框处理。 -->
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource MutedTextBrush}"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
            <TextBlock Text="搜索模组名称、中文别名或关键词" Foreground="{DynamicResource MutedTextBrush}" Margin="40,0,12,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <Button Grid.Column="1" Content="搜索模组" Command="{Binding SearchCommand}" Height="40" Margin="0"/>
        </Grid>
        <!-- 每个标签与输入框作为一组换行，小窗口下不会拆散标签和对应选项。 -->
        <WrapPanel Margin="0,16,0,0">
          <StackPanel Width="148" Margin="0,0,12,12">
            <TextBlock Text="模组来源" Style="{StaticResource FilterLabel}"/>
            <ComboBox ItemsSource="{Binding Providers}" SelectedIndex="{Binding ProviderIndex}" Height="40" Margin="0" AutomationProperties.Name="模组来源"/>
          </StackPanel>
          <StackPanel Width="110" Margin="0,0,12,12">
            <TextBlock Text="游戏版本" Style="{StaticResource FilterLabel}"/>
            <TextBox Text="{Binding GameVersion, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" Height="40"
                     ToolTip="游戏版本，例如 1.7.10；留空不限制搜索" AutomationProperties.Name="游戏版本"/>
          </StackPanel>
          <StackPanel Width="128" Margin="0,0,12,12">
            <TextBlock Text="加载器" Style="{StaticResource FilterLabel}"/>
            <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding Loader}" Height="40" Margin="0" AutomationProperties.Name="模组加载器">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource OnlineModLabel}, ConverterParameter=Loader}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Width="142" Margin="0,0,12,12">
            <TextBlock Text="分类" Style="{StaticResource FilterLabel}"/>
            <ComboBox ItemsSource="{Binding Categories}" SelectedIndex="{Binding CategoryIndex}" Height="40" Margin="0" AutomationProperties.Name="模组分类"/>
          </StackPanel>
          <StackPanel Width="128" Margin="0,0,12,12">
            <TextBlock Text="运行环境" Style="{StaticResource FilterLabel}"/>
            <ComboBox ItemsSource="{Binding Environments}" SelectedIndex="{Binding EnvironmentIndex}" Height="40" Margin="0" AutomationProperties.Name="运行环境"
                      ToolTip="环境筛选目前仅 Modrinth 提供；CurseForge 不会假定支持此筛选"/>
          </StackPanel>
          <StackPanel Width="132" Margin="0,0,12,12">
            <TextBlock Text="排序" Style="{StaticResource FilterLabel}"/>
            <ComboBox ItemsSource="{Binding Sorts}" SelectedIndex="{Binding SortIndex}" Height="40" Margin="0" AutomationProperties.Name="搜索结果排序"/>
          </StackPanel>
        </WrapPanel>
        <TextBlock Text="版本和加载器默认沿用所选实例。下载前会再次检查兼容性。" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="2,12,0,12"/>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardBorder}" Padding="8,16,8,8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="搜索结果" FontWeight="SemiBold" FontSize="15" Margin="12,0,12,12"/>
          <Button DockPanel.Dock="Bottom" Content="加载更多项目" Command="{Binding LoadMoreCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" Margin="4,8,4,0"/>
          <Grid>
          <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" IsEnabled="{Binding CanEdit}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="12"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource RaisedSurfaceBrush}" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid>
                      <TextBlock Text="{Binding Placeholder}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryAccentBrush}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IconPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                      </TextBlock>
                      <Image Source="{Binding IconPath}" Width="40" Height="40" Stretch="Uniform"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Caption}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock Text="{Binding DisplaySummary}" ToolTip="{Binding Project.Summary}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" FontSize="14" LineHeight="20"/>
                    <TextBlock Text="{Binding SummaryNote}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Projects.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
            <TextBlock Text="寻找你的下一个模组" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="输入中文或英文关键词，&#x0a;也可以调整版本和分类。" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22"/>
          </StackPanel>
          </Grid>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20">
        <Grid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="选择一个模组" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock Text="在这里查看介绍、选择兼容版本，&#x0a;并预览需要下载的文件和依赖。" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="24"/>
            <TextBlock Text="{Binding TargetText}" Foreground="{DynamicResource AccentBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,20,0,0"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <ScrollViewer.Style>
              <Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
            </ScrollViewer.Style>
        <StackPanel>
          <TextBlock Text="{Binding ProjectDisplayName}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ProjectInformation}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6"/>
          <TextBlock Text="{Binding ProjectDisplaySummary}" TextWrapping="Wrap" ToolTip="{Binding ProjectDetails.Summary}"/>
          <TextBlock Text="{Binding ProjectSummaryNote}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
          <Expander Header="查看平台原始简介">
            <TextBox Text="{Binding ProjectDetails.Summary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/>
          </Expander>
          <WrapPanel Margin="0,8,0,4"><Button Content="打开项目主页  ↗" Command="{Binding OpenProjectCommand}" Style="{StaticResource QuietButton}" Margin="-10,0,0,0"/></WrapPanel>
          <Expander Header="完整介绍（原文）">
            <TextBox Text="{Binding ProjectDetails.Description, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="190" BorderThickness="0"/>
          </Expander>
          <Expander Header="源码与问题反馈链接">
            <StackPanel>
              <TextBlock Text="源码" Foreground="{DynamicResource MutedTextBrush}"/>
              <TextBox Text="{Binding ProjectDetails.SourceUrl, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/>
              <TextBlock Text="问题反馈" Foreground="{DynamicResource MutedTextBrush}"/>
              <TextBox Text="{Binding ProjectDetails.IssuesUrl, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/>
            </StackPanel>
          </Expander>
          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16"/>
          <TextBlock Text="版本与依赖" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding DetailStatus}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,14"/>
          <StackPanel IsEnabled="{Binding CanEdit}">
            <TextBlock Text="选择精确版本" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Margin="0,4,0,6">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding VersionNumber}"/><Run Text=" · "/><Run Text="{Binding Channel, Converter={StaticResource OnlineModLabel}, ConverterParameter=Channel}"/><Run Text=" · "/><Run Text="{Binding Published, StringFormat=yyyy-MM-dd}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="更多版本" Command="{Binding LoadMoreVersionsCommand}" HorizontalAlignment="Left"/>
            <ComboBox ItemsSource="{Binding VersionDetails.Files}" SelectedItem="{Binding SelectedFile}" DisplayMemberPath="FileName" ToolTip="一个版本有多个文件时，请选择要安装的具体文件" Margin="0,0,0,6"/>
            <Expander Header="文件大小与校验信息"><TextBox Text="{Binding FileInformation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/></Expander>
            <Expander Header="版本更新说明（原文）"><TextBox Text="{Binding VersionDetails.Changelog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" MaxHeight="140" VerticalScrollBarVisibility="Auto"/></Expander>
            <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="10" Padding="14" Margin="0,12,0,8">
              <StackPanel>
                <CheckBox Content="自动加入必要依赖" IsChecked="{Binding IncludeRequired}"/>
                <TextBlock Text="关闭后仍可继续安装，但缺少必要依赖可能无法启动。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding DependencyInformation}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <TextBlock Text="可选依赖（默认不安装）" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <ItemsControl ItemsSource="{Binding OptionalDependencies}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected}" Margin="0,3" ToolTip="{Binding Dependency.Description}">
                    <StackPanel>
                      <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding DisplaySummary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="14" MaxHeight="60" LineHeight="20" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding SummaryNote}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <!-- 取消入口保持独立，不随编辑控件禁用。 -->
          <WrapPanel Margin="0,16,0,0">
            <Button Content="生成安装清单" Command="{Binding PreviewCommand}"/>
            <Button Content="取消解析" Command="{Binding PreviewCancelCommand}"/>
          </WrapPanel>
          <Border Background="{DynamicResource AccentSoftBrush}" Padding="14" Margin="0,4,0,16" CornerRadius="10">
            <StackPanel>
              <TextBlock Text="安装清单" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
              <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap"/>
              <TextBox Text="{Binding PlanDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/>
              <TextBlock Text="更改版本、文件或依赖选择后，需要重新生成清单。原包文件不会被自动替换。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <WrapPanel>
            <Button Content="确认下载并安装" Command="{Binding InstallCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
            <Button Content="取消下载" Command="{Binding InstallCancelCommand}"/>
          </WrapPanel>
          <ProgressBar Value="{Binding InstallPercent}" Minimum="0" Maximum="100" Height="5" Margin="0,4"/>
          <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
          <TextBox Text="{Binding InstallStatus, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,4,0,8"/>
        </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
