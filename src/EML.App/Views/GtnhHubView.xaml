<UserControl x:Class="EML.App.Views.GtnhHubView" Style="{StaticResource {x:Type UserControl}}"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:EML.App.Views">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,20,0">
    <TextBlock Text="GTNH 专区" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="本体下载、适配资源与旧版数据迁移。" Style="{StaticResource PageSubtitle}"/>
   </StackPanel>
   <StackPanel Grid.Column="1">
    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsPackDownloads}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="目标 GTNH 实例"/><Style.Triggers><DataTrigger Binding="{Binding IsMigration}" Value="True"><Setter Property="Text" Value="接收数据的新版 GTNH"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" IsEnabled="{Binding CanInteract}" AutomationProperties.Name="GTNH 目标实例">
     <ComboBox.ItemTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis"><TextBlock.Text><MultiBinding StringFormat="{}{0} · {1}"><Binding Path="Name"/><Binding Path="Version"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="1" Margin="0,0,0,14">
   <TextBlock Text="{Binding TargetStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12">
    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsPackDownloads}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="刷新 GTNH 实例" Command="{Binding RefreshTargetsCommand}">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding IsPackDownloads}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
    </Button>
    <WrapPanel>
     <Button Content="下载本体" Command="{Binding ShowPackDownloadsCommand}" Margin="0,0,8,0">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsPackDownloads}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     </Button>
     <Button Content="推荐模组" Command="{Binding ShowRecommendationsCommand}" Margin="0,0,8,0">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsRecommendations}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     </Button>
     <Button Content="资源包" Command="{Binding ShowResourcePacksCommand}" Margin="0,0,8,0">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsResourcePacks}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     </Button>
     <Button Content="光影" Command="{Binding ShowShadersCommand}" Margin="0,0,8,0">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsShaders}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     </Button>
     <Button Content="数据迁移" Command="{Binding ShowMigrationCommand}">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsMigration}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     </Button>
    </WrapPanel>
   </DockPanel>
  </StackPanel>
  <Grid Grid.Row="2" Visibility="{Binding IsPackDownloads, Converter={StaticResource VisibleWhenTrue}}">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <views:GtnhPackDownloadView x:Name="PackDownloadPage" DataContext="{Binding Packs}"/>
   <StackPanel Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding Packs.IsInstalling, Converter={StaticResource VisibleWhenTrue}}">
    <TextBlock Text="导入与依赖补全进度" FontWeight="SemiBold"/>
    <ProgressBar Value="{Binding Instances.TransferPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8"/>
    <TextBlock Text="{Binding Instances.TransferStatus}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2" Visibility="{Binding IsCatalogPage, Converter={StaticResource VisibleWhenTrue}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardBorder}" Padding="14">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="适配项目" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInteract}" ToolTip="搜索名称、用途或项目仓库" AutomationProperties.Name="搜索 GTNH 推荐模组"/>
      <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" IsEnabled="{Binding CanInteract}" Margin="0,8,0,0" AutomationProperties.Name="GTNH 项目功能分类"/>
      <ComboBox ItemsSource="{Binding RuleFilters}" SelectedIndex="{Binding RuleFilterIndex}" IsEnabled="{Binding CanInteract}" Margin="0,8,0,0" AutomationProperties.Name="GTNH 项目规则分组" Visibility="{Binding IsRecommendations, Converter={StaticResource VisibleWhenTrue}}"/>
      <TextBlock Text="{Binding CatalogSummary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,10,0,0"/>
     </StackPanel>
     <Button DockPanel.Dock="Bottom" Content="查看 Wiki 可添加模组指南 ↗" Command="{Binding OpenGuideCommand}" Style="{StaticResource QuietButton}" FontSize="12" Margin="0,8,0,0"/>
     <ListBox ItemsSource="{Binding Addons}" SelectedItem="{Binding SelectedAddon}" IsEnabled="{Binding CanInteract}"
       BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <ListBox.ItemTemplate><DataTemplate>
       <StackPanel Margin="2,8">
        <TextBlock Text="{Binding Category}" Foreground="{DynamicResource SecondaryAccentBrush}" FontSize="12" Margin="0,0,0,4"/>
        <TextBlock Text="非星门规则" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,0,0,4" Visibility="{Binding IsNonStargate, Converter={StaticResource VisibleWhenTrue}}"/>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
       </StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20">
    <Grid>
     <TextBlock Text="{Binding CatalogEmptyMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Visibility="{Binding IsCatalogEmpty, Converter={StaticResource VisibleWhenTrue}}"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding IsCatalogEmpty}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
     <StackPanel>
      <TextBlock Text="{Binding SelectedAddon.Name, TargetNullValue=选择一个适配项目}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding SelectedAddon.Summary}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
      <TextBlock Text="{Binding SelectedAddon.SourceDisplay, StringFormat=来源：{0}}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
      <TextBlock Text="{Binding SelectedAddon.ProjectUrl}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <WrapPanel Margin="0,8,0,16"><Button Content="作者主页 ↗" Command="{Binding OpenAddonWebsiteCommand}" Style="{StaticResource QuietButton}"/><Button Content="刷新发行版本" Command="{Binding RefreshReleasesCommand}" Style="{StaticResource QuietButton}"/></WrapPanel>
      <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="9" Padding="12">
       <StackPanel><TextBlock Text="安装前看这里" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding SelectedAddon.Notes, TargetNullValue=这里收录专门适配 GTNH 的项目。请先选择目标实例，再核对作者的版本说明。}" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
      <Border CornerRadius="9" Padding="12" Margin="0,10,0,0" BorderThickness="1" BorderBrush="{DynamicResource DangerBrush}" Visibility="{Binding IsNonStargateAddon, Converter={StaticResource VisibleWhenTrue}}">
       <StackPanel><TextBlock Text="非星门规则" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding SelectedAddon.RuleDescription}" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
      <TextBlock Text="常规分类也不代表所有发行版本均符合星门规则；请核对作者说明和服务端要求。" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding IsRecommendations, Converter={StaticResource VisibleWhenTrue}}"/>
      <TextBlock Text="发行版本" FontWeight="SemiBold" Margin="0,18,0,8"/>
      <ComboBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanInteract}" MaxDropDownHeight="260" AutomationProperties.Name="GTNH 模组发行版本"/>
      <TextBlock Text="{Binding ReleaseStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,10"/>
      <TextBlock Text="{Binding SelectedRelease.Problem}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <Expander Header="发行说明与文件信息" Margin="0,0,0,12">
       <StackPanel Margin="0,8,0,0">
        <TextBlock Text="{Binding SelectedRelease.FileName}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding SelectedRelease.Size, StringFormat=大小：{0:N0} 字节}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
        <TextBlock Text="{Binding SelectedRelease.Published, StringFormat=发布于 {0:yyyy-MM-dd}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
        <TextBox Text="{Binding SelectedRelease.Notes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="180" Margin="0,8,0,8"/>
        <Button Content="打开完整发行说明 ↗" Command="{Binding OpenReleaseWebsiteCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
       </StackPanel>
      </Expander>
      <CheckBox IsChecked="{Binding CompatibilityConfirmed}" IsEnabled="{Binding CanInteract}" Margin="0,4,0,14">
       <TextBlock Text="我已核对目标 GTNH 版本、Java 要求和前置依赖，确认安装这个版本。" TextWrapping="Wrap"/>
      </CheckBox>
      <WrapPanel>
       <Button Content="下载并安装到所选实例" Command="{Binding InstallCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
       <Button Content="取消下载" Command="{Binding InstallCancelCommand}" Margin="0,0,0,8" Visibility="{Binding IsInstalling, Converter={StaticResource VisibleWhenTrue}}"/>
      </WrapPanel>
      <ProgressBar Value="{Binding DownloadPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8,0,8"/>
      <TextBlock Text="{Binding DownloadText}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
      <TextBox Text="{Binding InstallStatus, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0,8"/>
      <TextBlock Text="{Binding InstallationHint}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </StackPanel>
    </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource CardBorder}" Visibility="{Binding IsMigration, Converter={StaticResource VisibleWhenTrue}}">
   <ScrollViewer x:Name="MigrationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <TextBlock Text="把熟悉的世界，带到新版 GTNH" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="旧实例保留原件，新实例接收存档与本地记录。预览并确认后才会复制文件。" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,8,0,16"/>
     <!-- 来源仍在迁移弹窗中选择，页面不将当前目标误标成已选来源。 -->
     <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource RaisedSurfaceBrush}" CornerRadius="8" Padding="14">
       <StackPanel>
        <TextBlock Text="来源 · 旧实例" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
        <TextBlock Text="在迁移预览中选择" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
      <TextBlock Grid.Column="1" Text="→" FontSize="22" Foreground="{DynamicResource SecondaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Border Grid.Column="2" Background="{DynamicResource RaisedSurfaceBrush}" CornerRadius="8" Padding="14">
       <StackPanel>
        <TextBlock Text="接收 · 新实例" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
        <TextBlock Text="{Binding SelectedTarget.Name, TargetNullValue=请在页面上方选择新版, FallbackValue=请在页面上方选择新版}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
     </Grid>
     <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,18">
      <StackPanel>
       <TextBlock Text="1  导入带本地数据的旧实例" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <TextBlock Text="旧实例已在 EML 中可跳过。否则请导入 Prism 等启动器导出的完整 ZIP，包含存档、地图、服务器列表等个人数据；重新下载的安装包不含游玩记录。" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <WrapPanel>
        <Button x:Name="ImportOldInstanceButton" Content="导入旧实例（含本地数据）" Command="{Binding ImportOldInstanceCommand}" Margin="0,0,8,8" AutomationProperties.Name="导入旧 GTNH 实例及本地数据"/>
        <Button Content="取消导入" Command="{Binding ImportOldInstanceCancelCommand}" Margin="0,0,0,8" Visibility="{Binding IsImportingOldInstance, Converter={StaticResource VisibleWhenTrue}}"/>
       </WrapPanel>
       <TextBlock Text="{Binding MigrationImportHint}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <TextBlock Text="2  准备并选择新版实例" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="先为新版完成依赖补全并试运行，再在页面上方选择接收实例。保留旧版作为迁移来源。" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <TextBlock Text="3  预览并迁移本地数据" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="点击“从旧 GTNH 迁入数据”，选择旧实例、核对范围与冲突后开始复制。导入不会自动迁移。" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <TextBlock Text="语言偏好会保留，旧版完整汉化包不会复制到新版。额外模组迁移需单独选择并确认兼容风险；不要直接跨越多个大版本迁移存档。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,18"/>
     <WrapPanel IsEnabled="{Binding HasTarget}">
      <Button Content="从旧 GTNH 迁入数据" Command="{Binding Instances.MigratePlayerDataCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
      <Button Content="取消迁移" Command="{Binding Instances.MigratePlayerDataCancelCommand}" Margin="0,0,8,8"/>
      <Button Content="恢复上次迁移" Command="{Binding Instances.RestoreMigrationCommand}" Margin="0,0,8,8"/>
      <Button Content="取消恢复预检" Command="{Binding Instances.RestoreMigrationCancelCommand}" Margin="0,0,0,8"/>
     </WrapPanel>
     <ProgressBar Value="{Binding Instances.TransferPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,12,0,8"/>
     <TextBlock Text="{Binding Instances.TransferStatus}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
     <TextBox Text="{Binding Instances.MigrationStatus, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0,12"/>
     <TextBlock Text="迁移记录及备份位置" FontWeight="SemiBold" Margin="0,16,0,8"/>
     <TextBox Text="{Binding Instances.MigrationJournalPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</UserControl>
