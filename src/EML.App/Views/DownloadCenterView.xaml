<UserControl x:Class="EML.App.Views.DownloadCenterView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="下载中心" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="管理文件下载、传输速度与等待队列。" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,12">
   <Expander Header="下载设置" IsExpanded="False">
    <StackPanel Margin="0,12,0,0" IsEnabled="{Binding CanInteract}">
     <WrapPanel>
      <StackPanel Width="135" Margin="0,0,14,0">
       <TextBlock Text="并发下载数（1–8）" FontSize="12" Margin="0,0,0,6"/>
       <TextBox x:Name="ConcurrentInput" Text="{Binding MaxConcurrentText, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" AutomationProperties.Name="并发下载数"/>
      </StackPanel>
      <StackPanel Width="200" Margin="0,0,14,0">
       <TextBlock Text="总限速（KiB/s，0 不限速）" FontSize="12" Margin="0,0,0,6"/>
       <TextBox x:Name="RateLimitInput" Text="{Binding RateLimitKiBText, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" AutomationProperties.Name="总下载限速"/>
      </StackPanel>
      <Button Content="保存下载设置" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
     </WrapPanel>
     <TextBlock Text="{Binding SettingsStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
   </Expander>
  </Border>
  <Grid Grid.Row="2" Margin="0,0,0,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel>
    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalSpeed}" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0"/>
    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
   </DockPanel>
   <WrapPanel Grid.Row="1" Margin="0,10,0,0">
    <Button Content="全部暂停" Command="{Binding PauseAllCommand}" Margin="0,0,8,0" ToolTip="暂停当前队列，随后加入的下载也会等待"/>
    <Button Content="全部继续" Command="{Binding ResumeAllCommand}" Margin="0,0,8,0"/>
    <Button Content="清理结束记录" Command="{Binding ClearFinishedCommand}" Style="{StaticResource QuietButton}" ToolTip="只清理记录，不删除文件或缓存"/>
   </WrapPanel>
  </Grid>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardBorder}" Padding="10">
    <ListBox x:Name="TaskList" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
       IsEnabled="{Binding CanInteract}" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
       AutomationProperties.Name="下载文件列表">
     <ListBox.ItemTemplate><DataTemplate>
      <StackPanel Margin="8,10">
       <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
       <DockPanel Margin="0,5,0,7">
        <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="8,0,0,0"/>
        <TextBlock Text="{Binding GroupName}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
       </DockPanel>
       <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Maximum="100" Height="4"/>
       <DockPanel Margin="0,6,0,0">
        <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedText}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,0,0"/>
        <TextBlock Text="{Binding ProgressText}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}"/>
       </DockPanel>
       <TextBlock Text="{Binding TransferText}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
      </StackPanel>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14">
    <ScrollViewer x:Name="TaskDetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="文件详情" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="选中文件后可以暂停、继续或取消。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,12"/>
      <TextBlock Text="{Binding SelectedTask.DisplayName}" TextWrapping="Wrap" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding SelectedTask.GroupName}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0"/>
      <TextBlock Text="{Binding SelectedTask.StateText}" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
      <WrapPanel Margin="0,10,0,0">
       <Button Content="暂停" Command="{Binding PauseCommand}" Margin="0,0,6,6"/>
       <Button Content="继续" Command="{Binding ResumeCommand}" Margin="0,0,6,6"/>
       <Button Content="取消文件" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,6"/>
      </WrapPanel>
      <TextBlock Text="等待优先级" FontSize="12" Margin="0,10,0,6"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox ItemsSource="{Binding Priorities}" SelectedIndex="{Binding SelectedPriorityIndex}" IsEnabled="{Binding CanInteract}" AutomationProperties.Name="文件下载优先级"/>
       <Button Grid.Column="1" Content="应用" Command="{Binding ApplyPriorityCommand}" Margin="8,0,0,0"/>
      </Grid>
      <TextBlock Text="优先级只影响等待或暂停中的文件。" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
      <TextBlock Text="保存位置" FontSize="12" Margin="0,0,0,6"/>
      <TextBox x:Name="DestinationText" Text="{Binding SelectedTask.DestinationPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="84" VerticalScrollBarVisibility="Auto" FontSize="12" AutomationProperties.Name="文件保存位置"/>
      <TextBlock Text="{Binding SelectedTask.TransferText}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
      <TextBox x:Name="TaskErrorText" Text="{Binding SelectedTask.Error, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="110" MinHeight="0" BorderThickness="0" Background="Transparent" Padding="0,8" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource DangerBrush}" FontSize="12" AutomationProperties.Name="文件下载错误"/>
      <TextBlock Text="失败或取消后，请回到原下载或补全页面重试。全部暂停后，新加入的下载也会等待。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <TextBox Grid.Row="4" Text="{Binding ActionStatus, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="52" MinHeight="0" Padding="0,10,0,0" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.Name="下载操作结果"/>
 </Grid>
</UserControl>
