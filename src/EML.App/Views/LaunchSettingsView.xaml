<UserControl x:Class="EML.App.Views.LaunchSettingsView" Style="{StaticResource {x:Type UserControl}}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EML.App.Views">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,20,0">
        <TextBlock Text="启动设置" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="按实例保存玩家身份、Java 与运行参数" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="设置应用到实例" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,6"/>
        <ComboBox x:Name="TargetSelector" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                  DisplayMemberPath="Name" IsEnabled="{Binding CanInteract}" AutomationProperties.Name="启动设置目标实例"
                  ToolTip="各实例分别保留本次编辑；重启 EML 后保留偏好需点击保存设置"/>
      </StackPanel>
    </Grid>
    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
      <StackPanel>
        <Border Style="{StaticResource CardBorder}" Padding="24" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="玩家身份" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <views:LaunchIdentitySelector x:Name="LaunchIdentity"/>
            <TextBlock Text="离线模式需要输入玩家名；正版模式直接使用已登录账号的 Minecraft 玩家名。切换身份会改变 UUID，存档中的背包与进度可能随之变化。"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardBorder}" Padding="24" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Java 与内存" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <StackPanel IsEnabled="{Binding CanEditLaunchSettings}">
              <TextBlock Text="Java 可执行文件" Margin="0,0,0,7"/>
              <ComboBox x:Name="JavaPathInput" IsEditable="True" IsTextSearchEnabled="False"
                        ItemsSource="{Binding Java.Installations}" DisplayMemberPath="ExecutablePath"
                        Text="{Binding SelectedJavaPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="启动 Java 路径"
                        ToolTip="可选择检测到的 Java，或输入 java.exe 完整路径；留空会自动匹配"/>
              <TextBlock Text="留空时自动匹配所需 Java；可在“Java 环境”中检测或下载。"
                         TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,8,0,18"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="初始内存（MB）" Margin="0,0,0,7"/>
                  <TextBox Text="{Binding MinMemoryMbText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="初始内存 MB"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="最大内存（MB）" Margin="0,0,0,7"/>
                  <TextBox Text="{Binding MaxMemoryMbText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="最大内存 MB"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardBorder}" Padding="24" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="附加 JVM 参数" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="没有特别需要时可以留空。内存由上方字段管理，附加参数不能覆盖游戏主类、classpath 等启动必需项。"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,14"/>
            <TextBox Text="{Binding AdditionalJvmArguments, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditLaunchSettings}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="附加 JVM 参数" ToolTip="支持带引号的参数；保存和启动前会校验"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,16,0,0">
      <StackPanel>
        <WrapPanel Margin="0,0,0,6">
          <Button Content="保存设置" Command="{Binding SaveLaunchSettingsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"/>
          <Button Content="重新读取" Command="{Binding ReloadLaunchSettingsCommand}" Margin="0,0,8,6" ToolTip="放弃尚未保存的输入，重新读取此实例的设置"/>
          <Button Content="使用当前设置启动" Command="{Binding LaunchGameCommand}" Margin="0,0,8,6"/>
          <Button Content="运行日志" Command="{Binding DataContext.OpenInstanceSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="logs" Style="{StaticResource QuietButton}" Margin="0,0,0,6"/>
        </WrapPanel>
        <TextBox Text="{Binding LaunchSettingsStatus, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="56"
                 MinHeight="0" Padding="0" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto"
                 Foreground="{DynamicResource MutedTextBrush}" FontSize="12" AutomationProperties.Name="启动设置结果"/>
        <TextBlock Text="{Binding LaunchStatus}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
