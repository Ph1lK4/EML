<UserControl x:Class="EML.App.Views.DialogSurface"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 FontFamily="{DynamicResource InterfaceFontFamily}" FontSize="14"
 Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
  <Grid KeyboardNavigation.TabNavigation="Cycle">
   <Grid.RowDefinitions>
    <RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <Grid Margin="18,0,8,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
     <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0">
      <TextBlock Text="E" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="EML" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
    </StackPanel>
    <Button x:Name="CloseAction" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
      Width="32" Height="30" MinHeight="0" Padding="0" Style="{DynamicResource QuietButton}"
      HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"
      ToolTip="关闭" AutomationProperties.Name="关闭对话框" Click="OnClose"/>
   </Grid>
   <Grid Grid.Row="1" Margin="24,12,24,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="ToneTile" Width="46" Height="46" CornerRadius="10" Background="{DynamicResource InfoSoftBrush}"
      VerticalAlignment="Top" Margin="0,0,14,0">
     <TextBlock x:Name="ToneIcon" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="22"
       Foreground="{DynamicResource SecondaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Column="1">
     <TextBlock x:Name="HeadingText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>
   </Grid>
   <ScrollViewer x:Name="BodyScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,16">
    <StackPanel x:Name="BodyPanel"/>
   </ScrollViewer>
   <Border Grid.Row="3" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
     BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="20,12,16,12">
    <WrapPanel x:Name="FooterActions" HorizontalAlignment="Right"/>
   </Border>
  </Grid>
 </Border>
</UserControl>
