<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EML.Tests：单元测试项目（xUnit）。
    测试「纯逻辑」的部分：启动命令拼接、后面的下载/校验也放这里。
    界面行为不在这里测，界面靠人工点（窗口、按钮、状态栏）。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    引用 Core 测接口与模型，引用 Infrastructure 测具体实现
    （VanillaLaunchPlanner 在 Infrastructure 里）。
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\EML.Core\EML.Core.csproj" />
    <ProjectReference Include="..\..\src\EML.Infrastructure\EML.Infrastructure.csproj" />
  </ItemGroup>

</Project>
